# ===== 数据库 =====
DB_HOST=localhost
DB_PORT=3306
DB_NAME=metrics_db
DB_USER=root
DB_PASSWORD=Metrics@2026

# ===== JWT =====
# 必填，至少 32 字节的随机串；可用 openssl rand -hex 32 生成，不要提交真实密钥
JWT_SECRET=
# 单位：分钟
JWT_ACCESS_EXPIRE_MINUTES=120
# 单位：天
JWT_REFRESH_EXPIRE_DAYS=7

# ===== 文件存储 =====
FILE_STORAGE_TYPE=LOCAL
FILE_STORAGE_DIR=./data/files
# 签名地址有效期（分钟）
FILE_SIGNED_URL_EXPIRE_MINUTES=10
# 必填，至少 32 字节的独立随机串；可用 openssl rand -hex 32 生成
FILE_SIGN_SECRET=
# FILE_STORAGE_TYPE=MINIO 时启用；密钥仅通过环境变量注入
MINIO_ENDPOINT=http://localhost:9000
# 浏览器访问预签名地址的 endpoint；与内网 endpoint 不同时填写，签名 Host 必须保持一致
MINIO_PUBLIC_ENDPOINT=
MINIO_REGION=us-east-1
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_BUCKET=metrics-files
MINIO_FORCE_PATH_STYLE=true
# 开发 bucket CORS 允许的前端来源（docker-compose 初始化使用）
MINIO_CORS_ALLOWED_ORIGINS=http://localhost:5173
# kkFileView 预览服务地址（OFFICE 文档在线预览；留空则预览接口返回 url=null，前端提示下载）
KKFILEVIEW_URL=

# ===== 飞书集成（不配置则集成整体不可用：免登 20006、推送 SKIPPED、事件回调拒绝）=====
FEISHU_APP_ID=
FEISHU_APP_SECRET=
# 浏览器 OAuth 回调地址（需与飞书后台「重定向 URL」一致），如 https://metrics.example.com/api/callback
FEISHU_REDIRECT_URI=
# 事件订阅 Encrypt Key / Verification Token（飞书后台「事件订阅」页获取）
FEISHU_ENCRYPT_KEY=
FEISHU_VERIFICATION_TOKEN=
# 平台对外访问基础地址（消息卡片链接拼接），如 https://metrics.example.com
FEISHU_APP_BASE_URL=
# 消息推送轮询（便携 / 测试环境可置 false 关闭）
FEISHU_PUSH_ENABLED=true
FEISHU_PUSH_INTERVAL_MS=60000
# 首次绑定票据有效期（分钟）
FEISHU_BINDING_TICKET_EXPIRE_MINUTES=10

# ===== 校内教师身份核验（仅首次飞书绑定使用）=====
# 内网或已加白名单的外网服务地址，不包含 /api/fr/... 路径
TEACHER_API_BASE_URL=
# 必填，从环境变量注入，禁止提交真实密钥
TEACHER_API_ACCESS_KEY=
TEACHER_API_CONNECT_TIMEOUT_MS=3000
TEACHER_API_READ_TIMEOUT_MS=5000
# 仅限 local 验收环境临时使用；格式：工号1:姓名1,工号2:姓名2。生产环境必须保持 false
TEACHER_API_MOCK_ENABLED=false
TEACHER_API_MOCK_IDENTITIES=

# ===== 接口文档 =====
# 生产环境必须置 false（API 约定第 14 章）
SWAGGER_ENABLED=true

# ===== 服务端口 =====
SERVER_PORT=8081

# ===== 大屏 =====
# 大屏聚合数据本地缓存秒数（1–300 之间按需调整）
SCREEN_CACHE_SECONDS=120

# ===== 限流（API 约定第 13 章）=====
RATE_LIMIT_ENABLED=true
RATE_LIMIT_LOGIN_PER_MINUTE=10
RATE_LIMIT_API_PER_MINUTE=300
RATE_LIMIT_EXPORT_PER_MINUTE=5

# ===== 截止提醒定时任务 =====
# 便携 / 测试环境可置 false 关闭
REMINDER_ENABLED=true
# 默认每天 08:30 扫描（Spring cron：秒 分 时 日 月 周）
REMINDER_CRON=0 30 8 * * ?
