# ===== 数据库 =====
DB_HOST=localhost
DB_PORT=3306
DB_NAME=metrics_db
DB_USER=root
DB_PASSWORD=Metrics@2026

# ===== JWT =====
# 至少 32 字节的随机串，生产必须更换
JWT_SECRET=please-change-me-to-a-random-64-char-string-for-production
# 单位：分钟
JWT_ACCESS_EXPIRE_MINUTES=120
# 单位：天
JWT_REFRESH_EXPIRE_DAYS=7

# ===== 文件存储 =====
FILE_STORAGE_TYPE=LOCAL
FILE_STORAGE_DIR=./data/files
# 签名地址有效期（分钟）
FILE_SIGNED_URL_EXPIRE_MINUTES=10
FILE_SIGN_SECRET=please-change-me-file-sign-secret
# kkFileView 预览服务地址（OFFICE 文档在线预览；留空则预览接口返回 url=null，前端提示下载）
KKFILEVIEW_URL=

# ===== 飞书集成（不配置则集成整体不可用：免登 20006、推送 SKIPPED、事件回调拒绝）=====
FEISHU_APP_ID=
FEISHU_APP_SECRET=
# 浏览器 OAuth 回调地址（需与飞书后台「重定向 URL」一致），如 https://metrics.example.com/feishu/callback
FEISHU_REDIRECT_URI=
# 事件订阅 Encrypt Key / Verification Token（飞书后台「事件订阅」页获取）
FEISHU_ENCRYPT_KEY=
FEISHU_VERIFICATION_TOKEN=
# 平台对外访问基础地址（消息卡片链接拼接），如 https://metrics.example.com
FEISHU_APP_BASE_URL=
# 消息推送轮询（便携 / 测试环境可置 false 关闭）
FEISHU_PUSH_ENABLED=true
FEISHU_PUSH_INTERVAL_MS=60000

# ===== 接口文档 =====
# 生产环境必须置 false（API 约定第 14 章）
SWAGGER_ENABLED=true

# ===== 服务端口 =====
SERVER_PORT=8080

# ===== 大屏 =====
# 大屏聚合数据本地缓存秒数（1–300 之间按需调整）
SCREEN_CACHE_SECONDS=120

# ===== 限流（API 约定第 13 章）=====
RATE_LIMIT_ENABLED=true
RATE_LIMIT_LOGIN_PER_MINUTE=10
RATE_LIMIT_API_PER_MINUTE=300
RATE_LIMIT_EXPORT_PER_MINUTE=5

# ===== 截止提醒定时任务 =====
# 便携 / 测试环境可置 false 关闭
REMINDER_ENABLED=true
# 默认每天 08:30 扫描（Spring cron：秒 分 时 日 月 周）
REMINDER_CRON=0 30 8 * * ?
