# HTTPS 配置示例：TLS 终止于外层 nginx，转发到 docker-compose.prod.yml 的 frontend（默认 127.0.0.1:80）
# 证书请向学校信息化部门或 CA 申请；飞书网页应用 / 事件回调要求公网 HTTPS 地址
# 用法：复制到 /etc/nginx/conf.d/metrics.conf，替换 server_name 与证书路径后 nginx -s reload

server {
    listen 80;
    server_name metrics.example.com;   # TODO 替换为实际域名
    # HTTP 全部跳转 HTTPS（API 约定第 13 章：全站 HTTPS）
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl;
    http2 on;
    server_name metrics.example.com;   # TODO 替换为实际域名

    ssl_certificate     /etc/nginx/ssl/metrics.example.com.pem;    # TODO 替换
    ssl_certificate_key /etc/nginx/ssl/metrics.example.com.key;    # TODO 替换
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_ciphers HIGH:!aNULL:!MD5;
    ssl_session_cache shared:SSL:10m;
    ssl_session_timeout 10m;

    # HSTS（API 约定第 13 章）
    add_header Strict-Transport-Security "max-age=31536000" always;
    add_header X-Content-Type-Options nosniff always;
    add_header X-Frame-Options SAMEORIGIN always;

    client_max_body_size 200m;

    location / {
        proxy_pass http://127.0.0.1:80;   # compose 中 frontend 映射端口（FRONTEND_PORT）
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_read_timeout 120s;
        proxy_send_timeout 120s;
    }
}
